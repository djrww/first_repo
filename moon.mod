  "omt",
  "smt",
  "cdcl-t",
  "euf",
  "lra",
  "lia",
  "gnn",
  "svm",
  "lrb",
  "qap",
  "rendering-engine",
  "rasterizer",
  "rtree",
  "sdf",
  "moonbit",
]

preferred_target = "wasm"

description = "Self-Developed OMT + GNN + CDCL(T) + Lazy SMT Unified Solver & Incremental Vector/Raster Rendering Engine in MoonBit"
