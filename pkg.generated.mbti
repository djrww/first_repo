pub fn SvmKernelMapper::with_capacity(SvmKernelKind, Double, Int) -> Self

pub(all) enum Term {
  Var(String, Int)
  IntConst(Int)
  RealConst(Double)
  App(String, Array[Int])
} derive(Eq)
pub fn Term::equal(Self, Self) -> Bool
pub fn Term::not_equal(Self, Self) -> Bool

